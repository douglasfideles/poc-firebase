# Copie para .env, ou rode ./preparar.sh, que gera os segredos. O .env não entra no git.

# --- gerados pelo preparar.sh
SESSAO_SEGREDO=
CAFE_PONTE_SEGREDO=
LDAP_SENHA_LEITOR=
LDAP_SENHA_PESSOAS=

# --- projeto Firebase (console.firebase.google.com > Configurações do projeto > Geral > seu app Web)
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=

# --- Authentication > Método de login > Google > Configuração do SDK da Web > ID do cliente da Web
# Sem este valor o login com Google fica desligado.
GOOGLE_WEB_CLIENT_ID=

# --- ID do aplicativo registrado no Entra ID. Sem este valor o login com Microsoft fica desligado.
MS_CLIENT_ID=
# ID do diretório (locatário) cujas contas entram aprovadas na Universidade A.
MS_TENANT_ID=

# --- Domínio do Google Workspace cujas contas entram aprovadas na Universidade A (ex.: uni.edu.br).
GOOGLE_HD=

# --- Endereço de login do SP SAML da CAFe. Vazio: usa a universidade simulada do ambiente de teste.
CAFE_SP_LOGIN_URL=

# --- Login único da Universidade B (OIDC). Vazio: desligado.
# OIDC_EMISSOR é o `issuer` do provedor (no Keycloak: https://<host>/realms/<realm>).
# Para o Keycloak de teste (docker compose --profile sso up -d keycloak):
#   OIDC_EMISSOR=http://localhost:8089/realms/unib
#   OIDC_CLIENT_ID=iotedu-poc
OIDC_EMISSOR=
OIDC_CLIENT_ID=
# Segredo do cliente. O preparar.sh gera um, que o Keycloak de teste também recebe.
OIDC_SEGREDO=
# Senha do administrador do Keycloak de teste (gerada pelo preparar.sh).
KEYCLOAK_ADMIN_SENHA=
